{
  "name": "super-perps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Educational mobile-only Phoenix Perps starter with Privy onboarding",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run check:repo && npm test",
    "check:repo": "node scripts/check-repo.mjs",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "audit:release": "npm audit --audit-level=high",
    "release:check": "npm run check && npm run licenses:check && npm run build && npm run audit:release",
    "test": "vitest run",
    "probe": "node --env-file-if-exists=.env.local --import tsx scripts/probe.ts",
    "probe:trading": "node --env-file-if-exists=.env.local --import tsx scripts/trading-probe.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@ellipsis-labs/rise": "0.6.2",
    "@privy-io/react-auth": "3.51.0",
    "@solana-program/compute-budget": "0.20.0",
    "@solana-program/memo": "0.16.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.5.0",
    "@vercel/analytics": "2.0.1",
    "decimal.js": "10.6.0",
    "jose": "6.2.15",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.61.0",
    "motion": "14.9.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-precaching": "7.4.1"
  },
  "overrides": {
    "zod@>=4.0.0 <4.6.6": "4.6.7",
    "ws@>=8.0.0 <8.21.0": "8.22.0",
    "uuid@>=8.3.2 <11.1.1": "11.1.1",
    "workbox-build@7.4.1": {
      "glob": "14.0.3"
    },
    "minimatch": "11.0.3"
  }
}
