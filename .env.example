# Public Phoenix PERPS API. This is mainnet data, not a devnet.
VITE_PHOENIX_API_URL=https://perp-api.phoenix.trade

# Optional Privy public application ID. Leave empty for credential-free data browsing.
# Enable Solana embedded wallets and permitted local/production origins in YOUR app.
# Never put a Privy app secret, private key, seed phrase, or server token in VITE_*.
VITE_PRIVY_APP_ID=

# Optional public client ID if your Privy dashboard uses app clients.
VITE_PRIVY_CLIENT_ID=

# Private server RPC. Required for wallet balances/trading through the relay.
# Use HTTPS mainnet; never prefix private URLs with VITE_. No wallet keys needed.
SOLANA_RPC_URL=
# Optional private WSS URL; blank derives wss from the private HTTPS RPC URL.
SOLANA_WS_URL=
# Exact comma-separated app origins, without paths or trailing slashes.
# Blank allows local dev/preview; on Vercel it allows only the exact VERCEL_URL.
# Add your production domain or temporary HTTPS tunnel explicitly.
RPC_ALLOWED_ORIGINS=
# Optional server-only App ID override; blank uses the public VITE_PRIVY_APP_ID.
PRIVY_APP_ID=

# Optional PUBLIC direct-provider alternative for static hosts. Blank uses the
# authenticated same-origin /api/solana relay. Every VITE_* value is public.
VITE_SOLANA_RPC_URL=

# Optional PUBLIC direct WebSocket alternative; otherwise derived from the
# browser RPC URL. Do not put a private provider key here.
VITE_SOLANA_WS_URL=

# Replace with your public repository URL when publishing.
# Example: https://github.com/YOUR_ORG/YOUR_REPO
VITE_REPOSITORY_URL=

# Optional basic Vercel Web Analytics. Enable it in your Vercel project dashboard
# and set true for hosted builds. Blank disables it; local dev never tracks.
VITE_WEB_ANALYTICS_ENABLED=

# Optional Flight monetization. Both blank means no app builder fee.
# Public registered authority; set the rate to 0 for zero-fee educational routing.
# For paid routing, use its exact registered integer rate: 1 bps means 0.01%.
# Register through https://flight.phoenix.trade. Orders verify registration/caps
# and encode the explicit rate, including 0 (never the registered default).
VITE_PHOENIX_BUILDER_AUTHORITY=
VITE_PHOENIX_BUILDER_FEE_BPS=

# Optional Phoenix-issued operator code, automatically included in new-account setup.
# Blank disables referrals. Disclosed before activation; no manual or URL overrides.
VITE_PHOENIX_REFERRAL_CODE=
